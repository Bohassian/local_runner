# Qwen3-Coder-Next: same 80B-A3B architecture, tuned for coding agents. No
# thinking. Tool calls use the qwen3_coder (XML-style) format.
MODEL_REPO=unsloth/Qwen3-Coder-Next-GGUF
MODEL_REVISION=ce09c67b53bc8739eef83fe67b2f5d293c270632
MODEL_FILE=Qwen3-Coder-Next-Q4_K_M.gguf
# Must match a model id in pi/agent/models.json.
ALIAS=qwen3-coder-next
# Qwen's recommended sampling (model card). min-p isn't specified there.
TEMP=1.0
TOP_P=0.95
TOP_K=40
MIN_P=0
EXTRA_ARGS=""
