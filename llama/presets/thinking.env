# Qwen3-Next-80B-A3B-Thinking: general model that always thinks first. Slower
# per step (thinking tokens), better on hard reasoning.
MODEL_REPO=unsloth/Qwen3-Next-80B-A3B-Thinking-GGUF
MODEL_REVISION=6e6e89e27c5a838dba47ba7b14501183b3d76e10
MODEL_FILE=Qwen3-Next-80B-A3B-Thinking-Q4_K_M.gguf
# Must match a model id in pi/agent/models.json.
ALIAS=qwen3-next-80b-a3b-thinking
# Qwen's recommended sampling.
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0
# Return thinking as `reasoning_content` so Pi shows it as a thinking block
# instead of mixing it into the answer.
EXTRA_ARGS="--reasoning-format deepseek"
