# Copy to .env and adjust as needed. .env is gitignored.

# --- Ollama ---
# Models pulled into the ollama container.
PRIMARY_MODEL=qwen2.5-coder:7b
EMBED_MODEL=nomic-embed-text

# Ollama port on the host (also the in-compose URL for the mcp-memory container).
OLLAMA_HOST_PORT=11434

# Where mcp-memory reaches Ollama for embeddings.
# v1: same Ollama instance as the generator (in compose: http://ollama:11434).
# Phase 4: swap to the secondary machine's LAN URL (e.g. http://192.168.1.42:11434).
EMBED_BASE_URL=http://ollama:11434

# --- mcp-memory ---
# Host port mcp-memory listens on (Cline points at http://localhost:${MCP_MEMORY_PORT}/mcp).
MCP_MEMORY_PORT=3939
