# Copy to .env and adjust as needed. .env is gitignored.

# --- Ollama ---
# Embedding model pulled into the ollama container.
EMBED_MODEL=nomic-embed-text

# Ollama's default context window. Ollama now serves embeddings only, so this
# just needs to cover one ingest chunk.
OLLAMA_CONTEXT_LENGTH=32768

# Ollama port on the host (also the in-compose URL for the mcp-memory container).
OLLAMA_HOST_PORT=11434

# Where mcp-memory reaches Ollama for embeddings.
# In compose: http://ollama:11434.
# Phase 4: swap to the secondary machine's LAN URL (e.g. http://192.168.1.42:11434).
EMBED_BASE_URL=http://ollama:11434

# --- llama.cpp (chat model for Pi) ---
# GGUF pulled by llama-pull. Revision is a Hugging Face commit SHA; bumping it
# downloads a fresh copy alongside the old one (clean up the volume yourself).
LLAMA_MODEL_REPO=unsloth/Qwen3-Next-80B-A3B-Instruct-GGUF
LLAMA_MODEL_REVISION=6688872b7a4e5eb8a121ceea08009530a024ba1d
LLAMA_MODEL_FILE=Qwen3-Next-80B-A3B-Instruct-Q4_K_M.gguf
# Must match the model id in pi/agent/models.json.
LLAMA_MODEL_ALIAS=qwen3-next-80b-a3b

# Context window (tokens). Qwen3-Next keeps KV for only 1 in 4 layers, so
# this is cheap; keep pi/agent/models.json contextWindow in sync.
LLAMA_CONTEXT_LENGTH=131072

# MoE expert layers kept in system RAM (0-48). Lower = more on GPU = faster,
# until it OOMs. Tune while watching nvidia-smi.
LLAMA_N_CPU_MOE=44

# Memory cap for the llama container (RAM + its share of page cache). Q4_K_M
# needs ~36-38 GB after GPU offload. If `docker stats` shows it pinned at the
# cap, drop to a smaller quant (e.g. IQ4_XS) rather than raising this.
LLAMA_MEM_LIMIT=42g

# Host port (bound to 127.0.0.1 only). Pi reaches it in-network instead.
LLAMA_HOST_PORT=8080

# --- mcp-memory ---
# UID/GID the mcp-memory container runs as. Must match the host user that runs
# the ingest scripts, so both can write the shared sqlite DB in ./data.
# (Check with `id -u` / `id -g`.)
HOST_UID=1000
HOST_GID=1000

# Host port mcp-memory is published on (for the MCP inspector at
# http://localhost:${MCP_MEMORY_PORT}/mcp). Pi reaches it in-network instead.
MCP_MEMORY_PORT=3939

# --- Ingest (host-side scripts) ---
# Where host ingest scripts read/write the sqlite-vec DB. The mcp-memory
# container sees the same file via the ./data bind-mount (at /app/data/...).
INGEST_DB_PATH=./data/mcp-memory.db

# Where host ingest scripts call Ollama for embeddings. They run outside
# Docker, so they hit the published host port (not the in-compose URL).
INGEST_EMBED_BASE_URL=http://localhost:11434
